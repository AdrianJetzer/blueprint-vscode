{
  // Blueprint: Claude Code in einem Dev Container für VS Code (Podman)
  "name": "claude-blueprint-vscode",

  "build": {
    "dockerfile": "Dockerfile"
  },

  // Im Container arbeiten wir als "dev", nie als root.
  "remoteUser": "dev",
  "containerUser": "dev",
  "updateRemoteUserUID": false,

  // Podman (rootless): Dein Mac-Benutzer wird im Container zu "dev" (UID 1000),
  // damit Claude im Projektordner schreiben darf.
  "runArgs": ["--userns=keep-id:uid=1000,gid=1000"],

  // Anmeldung von Claude und Gradle-Cache überleben einen Neubau,
  // bleiben aber in Volumes und kommen nie auf den Mac.
  "mounts": [
    "source=claude-blueprint-vscode-config,target=/home/dev/.claude,type=volume",
    "source=claude-blueprint-vscode-gradle,target=/home/dev/.gradle,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        // "Claude Code for VS Code" von Anthropic
        "anthropic.claude-code",
        // Gradle-Aufgaben in der Seitenleiste (Microsoft)
        "vscjava.vscode-gradle",
        // Kotlin-Sprachunterstützung (Community, eher einfach)
        "fwcd.kotlin"
      ]
    }
  },

  // Kurzer Selbsttest nach dem Start
  "postCreateCommand": "java -version && claude --version && ./gradlew --version"
}
